---
import { links } from './links';
import styles from './links.module.css';
import Icon from '@/src/components/icon/icon.astro';
import ExternalLink from '@/src/components/external-link/external-link.astro';
---
{links && (
	<ul class={styles['link-list']}>
		{links.map((item) => {
			return item.omit ? null : (
				<li>
					<ExternalLink href={item.link} classNames={`cta-link ${styles.link}`}>
						<span class="sr-only">{item.text}</span>
						<span class="sr-only">&nbsp;(opens in a new tab)</span>
						<Icon type={item.icon.type} name={item.icon.name} />
					</ExternalLink>
				</li>
			);
		})}
	</ul>
)}