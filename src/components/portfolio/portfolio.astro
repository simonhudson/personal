---
import { portfolioData, type PortfolioItem } from './data';
import ExternalLink from '@/src/components/external-link/external-link.astro';
import styles from './portfolio.module.css';

const portfolioItems = portfolioData.filter((item: PortfolioItem) => !item.omit);

const renderLinkText = (url: string) => {
    try {
        const urlObj = new URL(url);
		const pathname = urlObj.pathname !== '/' ? urlObj.pathname : null;
		return `${urlObj.hostname}${pathname ?? ''}`;
    } catch (e) {
        return url;
    }
};
---
<section id="work">
	<div class="inner-wrap">
		<h2>Some of my work</h2>
		<div class={styles.portfolio__wrap}>
			{portfolioItems.map((item: PortfolioItem) => {
				return (
					<div class={styles.portfolio__item}>
						<img src={`https://placehold.co/600x400`} alt={`${item.title} screenshot`} class={styles.portfolio__image} />
						<div class={styles.portfolio__content}>
							<h3 class={styles.portfolio__title}>{item.title}</h3>
							<p class={styles.portfolio__meta_title}>{item.client} / {item.date}</p>
							<p class={styles.portfolio__link}>
								<ExternalLink href={item.link}>{renderLinkText(item.link)}</ExternalLink>
							</p>
							<p>{item.description}</p>
							{item.meta?.length && (
								<div class={styles.portfolio__meta}>
									{item.meta.map((metaItem: any) => (
										<div class={styles.portfolio__meta_item}>
											<p class={`${styles.portfolio__meta_title}`}>{metaItem.title}</p>
											<ul class={styles.portfolio__meta_list}>
												{metaItem.items.sort().map((item: string) => (
													<li class={styles.portfolio__meta_list_item}>{item}</li>
												))}
											</ul>
										</div>
									))}
								</div>
							)}
						</div>
					</div>
				);
			})}
		</div>
	</div>
</section>