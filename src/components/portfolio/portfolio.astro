---
import { portfolioData, type PortfolioItem } from './data';
import styles from './portfolio.module.css';

const portfolioItems = portfolioData.filter((item: PortfolioItem) => !item.omit);

---
<section id="work" class={styles.portfolio__wrap}>
	<div class="inner-wrap">
		<h1>My work</h1>
		{portfolioItems.map((item: PortfolioItem) => {
			return (
				<div class={styles.portfolio__item}>
					<a class={styles.portfolio__link} href={item.slug}>
						<img src={`/images/${item.slug}.png`} alt={`${item.title} screenshot`} class={styles.portfolio__image} />
						<h3 class={styles.portfolio__title}>{item.title}</h3>
						<p class={styles.portfolio__client}>{item.client}</p>
					</a>
				</div>
			);
		})}
	</div>
</section>