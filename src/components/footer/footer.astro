---
import styles from './footer.module.css';
import Music from '@/src/components/music/music.astro';
import Links from '@/src/components/links/links.astro';
const currentYear = new Date().getFullYear();
---
<footer class={styles.footer}>
    <div class="inner-wrap">
        <Links />
        <Music server:defer>
            <p slot="fallback"><a href="https://www.last.fm/user/veryconscious">View my Last.FM profile</a></p>
        </Music> 
    </div>
    <p class={styles.copyright}>&copy; Simon Hudson {currentYear}</p>
</footer>
