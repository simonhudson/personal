---
import { type MusicResponse } from '@/src/types/music.types';
import styles from './music.module.css';
import { GET } from '@/src/pages/api/music';

let response = await GET(Astro)
const data: MusicResponse = await response.json();
---
<div class={styles.music}>
    <img
        alt={`Now playing "${data.name}" by ${data.artist}`}
        class="circle-image"
        height={300}
        src={data.image}
        width={300}
    />
    <p>
        <a href={data.url}>
            <span>&quot;{data.name}&quot;</span>
            <span>by</span>
            <span>{data.artist}</span>
        </a>
        <span>{data.relativeTime}</span>
    </p>
</div>