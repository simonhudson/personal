---
import styles from './about.module.css';
import ExternalLink from '@/src/components/external-link/external-link.astro';

const { data } = Astro.props;
---
<section id="about" class={styles.about}>
	<div class="inner-wrap">
		<div class={styles.wrap}>
			<div class={styles.content}>
				<img
					class={`circle-image ${styles.image}`}
					alt="Simon Hudson"
					src="/images/self.png"
					width="200"
					height="200"
				/>
				<div>
					<h2>About me</h2>
					<p>I've been working in web design &amp; development since 2004, back when all this was just fields and we had to use <ExternalLink href="https://css-tricks.com/snippets/css/browser-specific-hacks/">a whole manner of nasty hacks to get our CSS working</ExternalLink>.</p>
					<p>In that time I have been involved in a wide range of projects, from small brochure-ware microsites through to enterprise-level single-page web apps serving millions of users.</p>
					<p>I am currently working as a <strong>Senior Full Stack Developer</strong> on the Digital Team at the <strong><ExternalLink href="https://www.redcross.org.uk/">British Red Cross</ExternalLink></strong>, building and maintaining our in-house Web Platform which powers sites such as <ExternalLink href="https://www.bridgingdivides.org.uk">Bridging Divides</ExternalLink>, <ExternalLink href="https://bitesizevolunteering.redcross.org.uk">Bitesize Volunteering</ExternalLink> and <ExternalLink href="https://vad.redcross.org.uk">WW1 Volunteers</ExternalLink></p>
				</div>
			</div>
		</div>
	</div>
</section>