---
import styles from './about.module.css';

const { data } = Astro.props;
---
<section id="about" class={styles.about}>
	<div class="inner-wrap">
		<div class={styles.wrap}>
			<h1>About me</h1>
			<div class={styles.content}>
				<img
					class={styles.image}
					alt="Simon Hudson"
					src="/images/self.png"
					width="200"
					height="200"
				/>
				<div>
					<p>I've been working in web design &amp; development since 2004, and in that time I have worked on a wide range of projects, from small brochure-ware microsites through to enterprise-level single-page web apps serving millions of users. I am passionate about web accessibility and how to build for assistive technologies. I'm also a big fan of good testing, sensible code, and striving for simple solutions to complex problems.</p>
				</div>
			</div>
		</div>
	</div>
</section>